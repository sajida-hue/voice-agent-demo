# Never commit actual values. Set these privately in Render.
OPENAI_API_KEY=
APP_PASSWORD=
PUBLIC_ORIGIN=http://localhost:3000
# Optional: defaults to gpt-realtime
OPENAI_REALTIME_MODEL=gpt-realtime

# Optional: enables Surabhi as the default choice; secrets remain on the server.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ch9J8IB6HKlEHQaWQFdk
ELEVENLABS_MODEL=eleven_flash_v2_5

# Enables the Google Meet panel; group, API key and bots must share region/workspace.
RECALL_REGION=us-east-1
RECALL_GOOGLE_LOGIN_GROUP_ID=
# Optional: omit to enter the Recall key only in the generated Terminal command.
RECALL_API_KEY=
